# Runtime database connection priority:
# 1. GAIA_DATABASE_URL (explicit override)
# 2. POSTGRES_URL (created automatically by the Vercel Supabase integration)
# 3. DATABASE_URL / SUPABASE_DB_URL
#
# Runtime traffic should use the Supabase transaction pooler. Keep sslmode=require.
# Never expose any database URL to browser code.
GAIA_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Schema migrations automatically prefer POSTGRES_URL_NON_POOLING when supplied by
# the Vercel/Supabase integration. This explicit override is optional.
GAIA_MIGRATION_DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# The public Vercel deployment is read-only. Crawling runs in the worker process.
GAIA_READ_ONLY=1
GAIA_AUTO_MIGRATE=0

# Continuous inventory worker.
GAIA_WORKER_CONCURRENCY=12
GAIA_CRAWL_LEASE_SECONDS=1800
GAIA_MARKET_DISCOVERY_INTERVAL=900
GAIA_UNIVERSE_DISCOVERY_INTERVAL=86400

# External lists are evidence only. At most this many candidate employer boards are
# probed per discovery cycle, and none enter the live catalog until a probe completes.
GAIA_CANDIDATE_PROBE_LIMIT=24

# Full Workday inventory. Requests remain globally paced inside the collector.
GAIA_WORKDAY_FULL_INVENTORY=1
GAIA_WORKDAY_MAX_PER_TERM=20000
GAIA_WORKDAY_GLOBAL_CONCURRENCY=1
GAIA_WORKDAY_MIN_INTERVAL=1.0

# Shared crawler tuning.
GAIA_HTTP_TIMEOUT=45
GAIA_VERIFY_CONCURRENCY=12
GAIA_LINK_CHECK_CONCURRENCY=20
