# Database connection priority:
# 1. GAIA_DATABASE_URL (explicit override)
# 2. POSTGRES_URL (created automatically by the Vercel Supabase integration)
# 3. DATABASE_URL / SUPABASE_DB_URL
#
# For a manually connected Supabase project, use the transaction pooler URL.
# Keep sslmode=require. Never expose any database URL to the browser.
GAIA_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# The public Vercel deployment must not run crawls.
GAIA_READ_ONLY=1
GAIA_INITIAL_SYNC=0
GAIA_AUTO_MIGRATE=0

# Local crawler tuning.
GAIA_CONCURRENCY=16
GAIA_WORKDAY_PAGE_CONCURRENCY=6
GAIA_DETAIL_CONCURRENCY=8
GAIA_LINK_CHECK_CONCURRENCY=20
